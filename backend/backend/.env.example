# Copy to backend/backend/.env and adjust. Never commit the real .env file.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# These defaults match the container started by `poetry run rav run reset-db`.
POSTGRES_DB=kbackend_db
POSTGRES_USER=kamran
POSTGRES_PASSWORD=supersecret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: tuning for the wait_for_db command (defaults: 30 retries, 2s delay)
# DB_WAIT_RETRIES=30
# DB_WAIT_DELAY=2
